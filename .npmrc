# No package in this project's dependency tree requires an install/postinstall
# script to function: better-sqlite3@13+ ships prebuilt native binaries
# directly inside its npm package (no build step, no download step), and
# every other dependency is pure JavaScript. The one exception, fsevents, is
# a macOS-only optional dependency that npm already skips entirely on
# Windows/Linux via its own "os" restriction.
#
# `npm ci` on some npm versions does not honor better-sqlite3's own
# "gypfile": false flag and attempts an unnecessary node-gyp rebuild, which
# fails on machines without a C++ build toolchain (e.g. Windows without
# Visual Studio Build Tools) even though the prebuilt binary it would have
# used is already present. Disabling lifecycle scripts entirely avoids this
# without disabling anything this project actually relies on.
ignore-scripts=true
